# Inventory artifacts synced from terraform/ — regenerate via scripts/sync-inventory.sh
inventory/*/hosts.yml
inventory/*/hosts.ini
inventory/*/credentials.json

# Ansible runtime
*.retry
.vault_pass

# Cluster secrets generated + persisted by the patroni role (per-cloud, reused across
# runs so replication/superuser passwords stay stable). Never commit these.
inventory/*/.patroni_*.pass

# pgBackRest SSH mesh keypair generated + persisted by the pgbackrest role. Never commit.
inventory/*/.pgbackrest_id_*
