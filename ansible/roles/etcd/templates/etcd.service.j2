{{ ansible_managed | comment }}
[Unit]
Description=etcd key-value store (POAF DCS for Patroni)
Documentation=https://etcd.io/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User={{ etcd_user }}
Group={{ etcd_group }}
ExecStart={{ etcd_server_bin }} --config-file {{ etcd_config_file }}
Restart=on-failure
RestartSec=5
# Bootstrapping waits for peers to appear before etcd reports ready.
TimeoutStartSec=120
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
